# Hub Zero environment variables.
#
# Local development: copy this file to apps/web/.env.local and fill in the values.
# Production: set the same names in the Vercel project settings.
# Never commit real values. .env.local is ignored by git.

# --- Supabase (Project Settings > API Keys, project linkhub-prod) ---
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in the browser; access is enforced by row-level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server-side only. Bypasses row-level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- PostHog (Project Settings > General) ---
# Project token (phc_...). Safe in the browser.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# API host: https://us.i.posthog.com (US cloud) or https://eu.i.posthog.com (EU cloud)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
