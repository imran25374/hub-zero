# Hub Zero environment variables.
#
# Local development: copy this file to apps/web/.env.local and fill in the values.
# Production: set the same names in the Vercel project settings.
# Never commit real values. .env.local is ignored by git.

# --- Supabase (project linkhub-prod) ---
# Project URL, e.g. https://<project-ref>.supabase.co
# Find it under the Connect button at the top of the project dashboard.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...): Project Settings > API Keys.
# Safe in the browser; row-level security limits what it can do.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): Project Settings > API Keys. Server only; bypasses row-level security.
# Used only by the /go click redirect to record clicks. In Vercel mark it Sensitive.
# Optional locally: without it links still work, clicks just aren't recorded. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- PostHog (Project Settings > General) ---
# Project token (phc_...). Safe in the browser.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# API host: https://us.i.posthog.com (US cloud) or https://eu.i.posthog.com (EU cloud)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Site address ---
# The canonical address used in the sitemap, canonical links and link previews.
# Optional: defaults to https://imransyednaqvi.com.
NEXT_PUBLIC_SITE_URL=

# --- Social publishing (Instagram) ---
# Instagram professional account id and a long-lived token from the Meta App Dashboard
# (Instagram > API setup with Instagram login > Generate token). Server only; in Vercel
# mark the token Sensitive. Used once to seed integration_tokens; the publish job
# refreshes the token itself after that.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Random string; Vercel sends it as "Authorization: Bearer <secret>" when its cron
# calls /api/social/publish. Generate with: openssl rand -hex 32
CRON_SECRET=
